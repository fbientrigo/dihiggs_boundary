*.tmp
*.partial

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large generated data
*.parquet
*.duckdb
*.h5
*.hdf5
*.csv
*.jsonl

# Keep small fixtures if needed
!tests/fixtures/*.csv
!tests/fixtures/*.json
!tests/fixtures/*.jsonl

