build/
cmake-build-*/
*.o
*.so
*.a
*.dll
*.dylib
*.exe

# Runtime data
data/runs/*
!data/runs/.gitkeep
scratch/*
!scratch/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.env
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
logs/
*.stderr
*.stdout

